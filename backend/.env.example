# ================= 复制为 .env 并填写 =================

# ---- 安全（生产务必修改）----
JWT_SECRET=please-change-me-to-a-long-random-string

# ---- LLM：DeepSeek（必须）----
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.2

# ---- Embedding：OpenAI 兼容 API（硅基流动免费 BGE-M3，必须）----
# 注册 https://siliconflow.cn 免费创建 API Key（无需绑卡）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sf-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ---- 数据库（SQLite 零安装；换 MySQL/Postgres 改连接串）----
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=mysql+asyncmy://user:pass@localhost:3306/rag?charset=utf8mb4
# PostgreSQL（P2 单元1 就绪）：建库用 `python scripts/pg_init.py`（create_all + stamp head），见 docs/P2-PG-MIGRATION.md
# DATABASE_URL=postgresql+asyncpg://rag_app:rag_app_password@localhost:5432/rag

# ---- 存储 ----
# UPLOAD_DIR=data/uploads
# CHROMA_DIR=data/.chroma
# MAX_UPLOAD_SIZE=209715200

# ---- RAG 参数（可选调优）----
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# TOP_K_FINAL=5
# USE_RERANK=false

# ---- 语义缓存 ----
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_THRESHOLD=0.92
# SEMANTIC_CACHE_TTL_SECONDS=86400

# ---- 限流 ----
# AUTH_RATE_LIMIT=10/minute
# CHAT_RATE_LIMIT=60/minute

# ---- 对外检索 API（业务系统集成）----
# 服务间调用用 X-API-Key（不复用用户 JWT）。留空 = 不启用外部 API。
# 生产部署时生成足够长的随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
# EXTERNAL_API_KEY=
# EXTERNAL_RATE_LIMIT=120/minute
# 对外问答（调用 LLM，成本更高）单独限流
# EXTERNAL_CHAT_RATE_LIMIT=20/minute

# ---- OCR ----
# OCR_ENGINE=rapid   # rapid / paddle

# ---- 知识图谱（第一期：防洪链，可选，默认关闭）----
# 关闭时：入库不抽取、检索不查图，主链路零影响。
# GRAPH_BACKEND=memory 只在本进程内有效（测试/试用）。
# 生产/本机长期使用用 neo4j：本机装 Neo4j Desktop（无需 Docker），启动数据库后填下面四项。
GRAPH_ENABLED=false
GRAPH_BACKEND=memory
# NEO4J 连接（GRAPH_BACKEND=neo4j 时必填密码）
# GRAPH_NEO4J_URI=bolt://localhost:7687
# GRAPH_NEO4J_USER=neo4j
# GRAPH_NEO4J_PASSWORD=
# GRAPH_NEO4J_DATABASE=neo4j
# 连接超时（秒）/ 连接池大小：连不上就快速降级，不拖住问答
# GRAPH_NEO4J_CONNECT_TIMEOUT_S=5
# GRAPH_NEO4J_POOL_SIZE=20
# 入库后同步图谱超时（秒）/ 检索时图查询超时（毫秒）
# GRAPH_SYNC_TIMEOUT_S=30
# GRAPH_QUERY_TIMEOUT_MS=800

# ---- 本体（Ontology RAG，可选，默认关闭）----
# 关闭时：不加载 YAML、不做本体路由，行为与未接入时完全一致。
# ONTOLOGY_ENABLED=true
# ONTOLOGY_PROFILE=tuning        # 对应 app/services/graph/ontology/profiles/<id>.yaml
# ONTOLOGY_MIN_FACTS=1           # 事实条数不够就回退到向量+BM25（保持 1：一张参数卡就是完整答案）

# ---- Celery + Redis（单元 J：多队列 worker 分层，可选）----
# Redis 只当 broker 调度器，任务真相仍在 PostgreSQL；use_celery=true 才走 Celery worker。
# REDIS_URL=redis://localhost:6379/0
# USE_CELERY=false
# 各队列并发上限（防内存/显存爆：解析/GPU 低并发，打向量高并发）
# CELERY_INGESTION_CONCURRENCY=1
# CELERY_PARSER_CONCURRENCY=1
# CELERY_PARSER_GPU_CONCURRENCY=1
# CELERY_EMBEDDING_CONCURRENCY=4
# CELERY_INDEXING_CONCURRENCY=2
# CELERY_MAINTENANCE_CONCURRENCY=1
